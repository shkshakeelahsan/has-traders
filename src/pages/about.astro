---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { ABOUT, CERTIFICATES, VALUES } from "../data/content";
import { SITE } from "../site";
---

<Base
  title="About the company"
  description={`${ABOUT.intro} ${ABOUT.focus}`}
>
  <PageHero
    eyebrow="About the company"
    title="One accountable partner, from requirement to execution"
    lede={ABOUT.intro}
  />

  <section class="border-b border-rule bg-surface">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 py-20 sm:px-8 lg:grid-cols-2">
      <p class="text-lede leading-relaxed">{ABOUT.approach}</p>
      <p class="rule-mark font-display text-2xl leading-snug font-bold sm:text-3xl">
        {ABOUT.focus}
      </p>
    </div>
  </section>

  <!-- Vision & mission -->
  <section aria-labelledby="direction" class="border-b border-rule">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <h2 id="direction" class="sr-only">Vision and mission</h2>
      <div class="grid gap-px bg-rule md:grid-cols-2">
        <article class="bg-paper p-8 sm:p-10">
          <p class="eyebrow">Vision</p>
          <p class="mt-5 font-display text-2xl leading-snug font-bold sm:text-3xl">
            {ABOUT.vision}
          </p>
        </article>
        <article class="bg-paper p-8 sm:p-10">
          <p class="eyebrow">Mission</p>
          <p class="mt-5 font-display text-2xl leading-snug font-bold sm:text-3xl">
            {ABOUT.mission}
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section aria-labelledby="values" class="border-b border-rule bg-navy text-white">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <p class="font-mono text-eyebrow tracking-[0.2em] text-white/50 uppercase">
        What we hold to
      </p>
      <h2 id="values" class="mt-4 max-w-2xl text-h2 font-bold">
        Five values guide every engagement
      </h2>
      <dl class="mt-12 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          VALUES.map((value, index) => (
            <div class="border-t border-white/15 pt-5">
              <dt class="flex items-baseline gap-3 font-display text-xl font-bold">
                <span class="font-mono text-label text-crimson">
                  {String(index + 1).padStart(2, "0")}
                </span>
                {value.name}
              </dt>
              <dd class="mt-2 text-sm leading-relaxed text-white/65">
                {value.detail}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Certificates -->
  <section aria-labelledby="registration" class="bg-surface">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <div class="rule-mark">
        <p class="eyebrow">Registration &amp; certification</p>
        <h2 id="registration" class="mt-3 max-w-2xl text-h2 font-bold">
          Registered to deliver with confidence
        </h2>
      </div>

      <ul class="mt-12 grid gap-10 md:grid-cols-2">
        {
          CERTIFICATES.map((certificate) => (
            <li class="flex flex-col gap-6 border border-rule p-6 sm:flex-row sm:p-8">
              <img
                src={certificate.src}
                alt={certificate.title}
                width="551"
                height="781"
                loading="lazy"
                class="w-full max-w-[190px] self-start border border-rule bg-white"
              />
              <div>
                <h3 class="font-display text-lg leading-snug font-bold">
                  {certificate.title}
                </h3>
                <p class="mt-2 font-mono text-label tracking-[0.14em] text-crimson uppercase">
                  {certificate.issuer}
                </p>
                <p class="mt-4 text-sm leading-relaxed text-mute">
                  {certificate.detail}
                </p>
              </div>
            </li>
          ))
        }
      </ul>

      <p class="mt-10 max-w-2xl text-sm text-mute">
        {SITE.legalName} was incorporated in {SITE.established} and operates
        nationwide through its own teams and a network of specialist delivery
        partners.
      </p>
    </div>
  </section>
</Base>
