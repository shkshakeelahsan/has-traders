---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { ABOUT, CERTIFICATES, VALUES } from "../data/content";
import { SITE } from "../site";
---

<Base
  title="About the company"
  description="HAS Traders (SMC-Private) Limited — founded 2024. Integrated supply, events, marketing and technology delivery through one accountable partner."
>
  <PageHero
    eyebrow="About the company"
    title="One accountable partner, from requirement to execution"
    lede={ABOUT.intro}
  />

  <section class="border-rule bg-surface border-b">
    <div
      class="mx-auto grid max-w-7xl gap-10 px-5 py-20 sm:px-8 lg:grid-cols-2"
    >
      <p class="text-lede leading-relaxed">{ABOUT.approach}</p>
      <p class="rule-mark text-2xl leading-snug font-bold sm:text-3xl">
        {ABOUT.focus}
      </p>
    </div>
  </section>

  <!-- Vision & mission -->
  <section aria-labelledby="direction" class="border-rule border-b">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <h2 id="direction" class="sr-only">Vision and mission</h2>
      <div class="bg-rule grid gap-px md:grid-cols-2">
        <article class="bg-paper p-8 sm:p-10">
          <h3 class="eyebrow">Vision</h3>
          <p class="mt-5 text-2xl leading-snug font-bold sm:text-3xl">
            {ABOUT.vision}
          </p>
        </article>
        <article class="bg-paper p-8 sm:p-10">
          <h3 class="eyebrow">Mission</h3>
          <p class="mt-5 text-2xl leading-snug font-bold sm:text-3xl">
            {ABOUT.mission}
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section
    aria-labelledby="values"
    class="border-rule bg-navy border-b text-white"
  >
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <p class="eyebrow text-white/50">What we hold to</p>
      <h2 id="values" class="text-h2 mt-4 max-w-2xl font-bold">
        Five values guide every engagement
      </h2>
      <dl class="mt-12 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          VALUES.map((value, index) => (
            <div class="border-t border-white/15 pt-5">
              <dt class="flex items-baseline gap-3 text-xl font-bold">
                <span class="text-label text-crimson-tint">
                  {String(index + 1).padStart(2, "0")}
                </span>
                {value.name}
              </dt>
              <dd class="mt-2 text-sm leading-relaxed text-white/65">
                {value.detail}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Certificates -->
  <section aria-labelledby="registration" class="bg-surface">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <div class="rule-mark">
        <p class="eyebrow">Registration &amp; certification</p>
        <h2 id="registration" class="text-h2 mt-3 max-w-2xl font-bold">
          Registered to deliver with confidence
        </h2>
      </div>

      <ul class="mt-12 grid gap-10 md:grid-cols-2">
        {
          CERTIFICATES.map((certificate) => (
            <li class="border-rule flex flex-col gap-6 border p-6 sm:flex-row sm:p-8">
              <img
                src={certificate.src}
                alt={certificate.title}
                width="551"
                height="781"
                loading="lazy"
                class="border-rule w-full max-w-[190px] self-start border bg-white"
              />
              <div>
                <h3 class="text-lg leading-snug font-bold">
                  {certificate.title}
                </h3>
                <p class="label text-crimson mt-2">{certificate.issuer}</p>
                <p class="text-mute mt-4 text-sm leading-relaxed">
                  {certificate.detail}
                </p>
              </div>
            </li>
          ))
        }
      </ul>

      <p class="text-mute mt-10 max-w-2xl text-sm">
        {SITE.legalName} was incorporated in {SITE.established} and operates nationwide
        through its own teams and a network of specialist delivery partners.
      </p>
    </div>
  </section>
</Base>
