---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { CLIENTS, SECTORS } from "../data/content";
---

<Base
  title="Our clients"
  description="HAS Traders supports international organizations, public infrastructure, industry, FMCG, telecom and relief programmes across Pakistan."
>
  <PageHero
    eyebrow="Our clients"
    title="Supporting leading institutions and brands"
    lede="Through our network of delivery partners, we serve international organizations, government bodies, industry and consumer brands — a portfolio that highlights our versatility and proven execution."
  />

  <section aria-labelledby="wall" class="border-rule bg-surface border-b">
    <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
      <h2 id="wall" class="eyebrow">Organisations served</h2>
      <ul class="bg-rule mt-8 grid gap-px sm:grid-cols-2 lg:grid-cols-4">
        {
          CLIENTS.map((client) => (
            <li class="bg-surface hover:bg-crimson-wash px-5 py-4 text-sm transition-colors">
              {client}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- The sector ledger: sector, clients, what we delivered, what came of it. -->
  <section aria-labelledby="ledger">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <div class="rule-mark">
        <p class="eyebrow">Sector ledger</p>
        <h2 id="ledger" class="text-h2 mt-3 max-w-3xl font-bold">
          What we delivered, and what came of it
        </h2>
      </div>

      {
        /*
        A real table: on desktop the columns carry meaning, so the header
        cells have to be programmatically tied to the data. Rows collapse to
        stacked blocks below lg, where each cell shows its own label.
      */
      }
      <table class="mt-12 w-full border-collapse text-left">
        <caption class="sr-only">
          Sectors served, with representative clients, services delivered and
          the outcome of each engagement
        </caption>
        <thead class="hidden lg:table-header-group">
          <tr class="border-ink/20 border-b">
            {
              [
                "Sector",
                "Representative clients",
                "Services delivered",
                "Progress / outcome",
              ].map((heading) => (
                <th
                  scope="col"
                  class="label text-mute w-1/4 pr-8 pb-3 align-bottom font-medium"
                >
                  {heading}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            SECTORS.map((row) => (
              <tr class="border-rule block border-b py-8 lg:table-row lg:py-0">
                <th
                  scope="row"
                  class="block pr-8 text-left text-xl leading-snug font-bold lg:table-cell lg:w-1/4 lg:py-8 lg:align-top"
                >
                  {row.sector}
                </th>

                <td class="block pt-4 pr-8 lg:table-cell lg:w-1/4 lg:py-8 lg:align-top">
                  <span class="label text-mute block lg:sr-only">Clients</span>
                  <ul class="text-mute mt-2 space-y-1 text-sm lg:mt-0">
                    {row.clients.map((client) => (
                      <li>{client}</li>
                    ))}
                  </ul>
                </td>

                <td class="block pt-4 pr-8 lg:table-cell lg:w-1/4 lg:py-8 lg:align-top">
                  <span class="label text-mute block lg:sr-only">
                    Services delivered
                  </span>
                  <ul class="mt-2 space-y-2 text-sm leading-relaxed lg:mt-0">
                    {row.delivered.map((item) => (
                      <li class="border-crimson border-l-2 pl-3">{item}</li>
                    ))}
                  </ul>
                </td>

                <td class="block pt-4 lg:table-cell lg:w-1/4 lg:py-8 lg:align-top">
                  <span class="label text-mute block lg:sr-only">
                    Progress / outcome
                  </span>
                  <ul class="text-mute mt-2 space-y-2 text-sm leading-relaxed lg:mt-0">
                    {row.outcome.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</Base>
