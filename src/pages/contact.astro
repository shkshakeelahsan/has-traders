---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { SITE } from "../site";
import { SERVICES } from "../data/content";
---

<Base
  title="Contact us"
  description={`Contact HAS Traders for supply, transport, events and print projects across Pakistan. Email ${SITE.email} or call ${SITE.phones[0].number}.`}
>
  <PageHero
    eyebrow="Contact us"
    title="Let's deliver your next project together."
    lede="Tell us what you need supplied, moved, printed or run — we'll come back with a plan and a price."
  />

  <section
    aria-label="Contact details"
    class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20"
  >
    <div class="bg-rule grid gap-px lg:grid-cols-3">
      <div class="bg-paper p-8 sm:p-10">
        <h2 class="label text-mute">Call</h2>
        <ul class="mt-6 space-y-6">
          {
            SITE.phones.map((phone) => (
              <li>
                <a
                  href={`tel:${phone.number.replace(/\s/g, "")}`}
                  class="link-underline text-xl font-bold sm:text-2xl"
                >
                  {phone.number}
                </a>
                {phone.label && (
                  <span class="text-mute mt-1 block text-sm">
                    {phone.label}
                  </span>
                )}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="bg-paper p-8 sm:p-10">
        <h2 class="label text-mute">Email</h2>
        <a
          href={`mailto:${SITE.email}`}
          class="link-underline text-crimson mt-6 block text-xl font-bold break-all sm:text-2xl"
          >{SITE.email}</a
        >
        <p class="text-mute mt-3 text-sm">
          Include your timeline and delivery locations and we can scope the work
          on the first reply.
        </p>
      </div>

      <div class="bg-paper p-8 sm:p-10">
        <h2 class="label text-mute">Web</h2>
        <p class="mt-6 text-xl font-bold sm:text-2xl">
          {SITE.website}
        </p>
        <p class="text-mute mt-3 text-sm">
          {SITE.legalName}, established {SITE.established}. Operating nationwide
          across Pakistan.
        </p>
      </div>
    </div>

    <div class="rule-mark mt-16">
      <h2 class="text-h2 font-bold">What we can take on</h2>
      <ul class="mt-8 flex flex-wrap gap-3">
        {
          SERVICES.map((service) => (
            <li class="border-rule text-mute border px-4 py-2.5 text-sm">
              {service.name}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
