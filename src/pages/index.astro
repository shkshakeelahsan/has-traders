---
import Base from "../layouts/Base.astro";
import { SITE } from "../site";
import {
  ABOUT,
  CLIENTS,
  FOOTPRINT,
  PROJECTS,
  SECTORS,
  SERVICES,
} from "../data/content";

const cityCount = FOOTPRINT.reduce(
  (total, region) => total + region.cities.length,
  0,
);
const regionCount = FOOTPRINT.length;

const stats = [
  { value: String(cityCount), label: `Cities across ${regionCount} regions` },
  { value: "1,000+", label: "GPS-tracked vehicles in the partner fleet" },
  { value: String(CLIENTS.length), label: "Client organisations served" },
  { value: "ISO 9001", label: "Certified catering operations" },
];

const featured = PROJECTS.slice(0, 3);
---

<Base title={SITE.name} description={SITE.description}>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-rule bg-surface">
    <div
      class="mx-auto grid max-w-7xl items-center gap-12 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[1.05fr_0.95fr] lg:py-28"
    >
      <div>
        <p class="eyebrow enter">
          Established {SITE.established} &middot; Pakistan
        </p>
        <h1
          class="enter mt-5 text-display leading-[0.92] font-bold"
          style="--enter-delay: 90ms;"
        >
          Integrated solutions.<br />
          <span class="text-crimson">Reliable execution.</span><br />
          Every time.
        </h1>
        <p
          class="enter mt-7 max-w-xl text-lede leading-relaxed text-mute"
          style="--enter-delay: 180ms;"
        >
          {ABOUT.intro}
        </p>
        <div
          class="enter mt-9 flex flex-wrap items-center gap-4"
          style="--enter-delay: 260ms;"
        >
          <a
            href="/contact/"
            class="bg-crimson px-6 py-3.5 font-mono text-eyebrow tracking-[0.14em] text-white uppercase transition-colors hover:bg-crimson-deep"
            >Start a project</a
          >
          <a
            href="/services/"
            class="border border-ink/15 px-6 py-3.5 font-mono text-eyebrow tracking-[0.14em] uppercase transition-colors hover:border-ink hover:bg-paper"
            >What we do</a
          >
        </div>
      </div>

      <div>
        <div class="relative isolate px-6 py-10 sm:px-10">
          <div
            aria-hidden="true"
            class="absolute inset-y-0 right-0 left-10 -z-10 bg-paper sm:left-16"
          >
          </div>
          <div
            aria-hidden="true"
            class="absolute top-0 right-0 -z-10 h-20 w-20 bg-navy sm:h-28 sm:w-28"
          >
          </div>
          <img
            src="/logo-mark.png"
            alt={`${SITE.name} falcon emblem`}
            width="800"
            height="628"
            fetchpriority="high"
            class="enter mx-auto w-full max-w-md"
            style="--enter-delay: 140ms;"
          />
        </div>
        <p
          class="enter mt-6 text-center font-display text-xl font-bold tracking-tight sm:text-2xl"
          style="--enter-delay: 320ms;"
        >
          {SITE.tagline}
        </p>
      </div>
    </div>
  </section>

  <!-- Capability strip -->
  <section aria-labelledby="capabilities" class="border-b border-rule">
    <div class="mx-auto max-w-7xl px-5 py-14 sm:px-8">
      <h2 id="capabilities" class="eyebrow">One partner, multiple capabilities</h2>
      <ul class="mt-8 grid gap-px bg-rule sm:grid-cols-2 lg:grid-cols-5">
        {
          SERVICES.map((service) => (
            <li class="bg-paper">
              <a
                href="/services/"
                class="group block h-full p-5 transition-colors hover:bg-surface"
              >
                <span class="font-display text-lg leading-snug font-bold">
                  {service.name}
                </span>
                {service.partner && (
                  <span class="mt-2 block font-mono text-label tracking-[0.14em] text-crimson uppercase">
                    with {service.partner}
                  </span>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Scale -->
  <section aria-labelledby="scale" class="bg-navy text-white">
    <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
      <h2 id="scale" class="font-mono text-eyebrow tracking-[0.2em] text-white/50 uppercase">
        Delivery at scale
      </h2>
      <dl class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          stats.map((stat) => (
            <div class="border-t border-white/15 pt-5">
              <dt class="sr-only">{stat.label}</dt>
              <dd>
                <span class="block font-display text-4xl font-bold tracking-tight sm:text-5xl">
                  {stat.value}
                </span>
                <span class="mt-2 block text-sm text-white/65">{stat.label}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Sector ledger preview -->
  <section aria-labelledby="sectors" class="border-b border-rule">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <div class="rule-mark flex flex-wrap items-end justify-between gap-4">
        <h2 id="sectors" class="max-w-2xl text-h2 font-bold">
          A portfolio of relevant projects highlighting our versatility and proven
          execution
        </h2>
        <a
          href="/clients/"
          class="link-underline font-mono text-eyebrow tracking-[0.14em] text-crimson uppercase"
          >All sectors</a
        >
      </div>

      <ul class="mt-12 space-y-px bg-rule">
        {
          SECTORS.slice(0, 3).map((row) => (
            <li class="grid gap-4 bg-paper py-7 md:grid-cols-[0.9fr_1.1fr_1fr] md:gap-10">
              <h3 class="font-display text-xl font-bold">{row.sector}</h3>
              <p class="text-sm leading-relaxed text-mute">
                {row.clients.join(" · ")}
              </p>
              <p class="text-sm leading-relaxed text-mute">
                {row.delivered[0]}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Clients -->
  <section aria-labelledby="clients" class="border-b border-rule bg-surface">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <div class="rule-mark">
        <p class="eyebrow">Clients</p>
        <h2 id="clients" class="mt-3 max-w-3xl text-h2 font-bold">
          Supporting leading institutions and brands through our network of
          delivery partners
        </h2>
      </div>
      <ul class="mt-10 flex flex-wrap gap-x-3 gap-y-3">
        {
          CLIENTS.map((client) => (
            <li class="border border-rule px-4 py-2.5 text-sm text-mute transition-colors hover:border-crimson hover:text-ink">
              {client}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Projects preview -->
  <section aria-labelledby="work" class="border-b border-rule">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <div class="rule-mark flex flex-wrap items-end justify-between gap-4">
        <h2 id="work" class="text-h2 font-bold">Recent delivery</h2>
        <a
          href="/projects/"
          class="link-underline font-mono text-eyebrow tracking-[0.14em] text-crimson uppercase"
          >All projects</a
        >
      </div>
      <ul class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          featured.map((project) => (
            <li>
              <img
                src={project.image}
                alt={`${project.title} — ${project.client}`}
                width="1000"
                height="625"
                loading="lazy"
                class="aspect-[16/10] w-full object-cover"
              />
              <h3 class="mt-4 font-display text-lg font-bold">{project.title}</h3>
              <p class="mt-1 font-mono text-label tracking-[0.14em] text-crimson uppercase">
                {project.client}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="bg-crimson text-white">
    <div
      class="mx-auto flex max-w-7xl flex-col gap-8 px-5 py-16 sm:px-8 lg:flex-row lg:items-center lg:justify-between"
    >
      <h2 class="max-w-xl text-h2 leading-tight font-bold">
        Let's deliver your next project together.
      </h2>
      <div class="flex flex-wrap gap-4">
        <a
          href={`mailto:${SITE.email}`}
          class="bg-white px-6 py-3.5 font-mono text-eyebrow tracking-[0.14em] text-crimson uppercase transition-colors hover:bg-paper"
          >{SITE.email}</a
        >
        <a
          href="/contact/"
          class="border border-white/50 px-6 py-3.5 font-mono text-eyebrow tracking-[0.14em] uppercase transition-colors hover:bg-white/10"
          >Contact details</a
        >
      </div>
    </div>
  </section>
</Base>
