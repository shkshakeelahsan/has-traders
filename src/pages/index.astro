---
import Base from "../layouts/Base.astro";
import { SITE } from "../site";
import {
  ABOUT,
  CLIENTS,
  FLEET_SIZE,
  FOOTPRINT,
  PROJECTS,
  SECTORS,
  SERVICES,
} from "../data/content";

const cityCount = FOOTPRINT.reduce(
  (total, region) => total + region.cities.length,
  0,
);
const regionCount = FOOTPRINT.length;

const stats: { value: string; label: string; href?: string }[] = [
  {
    value: String(cityCount),
    label: `Cities across ${regionCount} regions`,
    href: "/footprint/",
  },
  { value: FLEET_SIZE, label: "GPS-tracked vehicles in the partner fleet" },
  { value: String(CLIENTS.length), label: "Client organisations served" },
  { value: "ISO 9001", label: "Certified catering operations" },
];

const featured = PROJECTS.slice(0, 3);
---

<Base title={SITE.name} description={SITE.description}>
  <!-- Hero -->
  <section class="border-rule bg-surface relative overflow-hidden border-b">
    <div
      class="mx-auto grid max-w-7xl items-center gap-12 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[1.05fr_0.95fr] lg:py-28"
    >
      <div>
        <h1
          class="enter text-display leading-[0.92] font-bold"
          style="--enter-delay: 90ms;"
        >
          Integrated solutions.<br />
          <span class="text-crimson">Reliable execution.</span><br />
          Every time.
        </h1>
        <p
          class="enter text-lede text-mute mt-7 max-w-xl leading-relaxed"
          style="--enter-delay: 180ms;"
        >
          {ABOUT.intro}
        </p>
        <div
          class="enter mt-9 flex flex-wrap items-center gap-4"
          style="--enter-delay: 260ms;"
        >
          <a
            href="/contact/"
            class="bg-crimson hover:bg-crimson-deep px-6 py-3.5 text-sm font-medium text-white transition-colors"
            >Start a project</a
          >
          <a
            href="/services/"
            class="border-ink/15 hover:border-ink hover:bg-paper border px-6 py-3.5 text-sm font-medium transition-colors"
            >What we do</a
          >
        </div>
      </div>

      <div>
        <img
          src="/logo-mark.svg"
          alt={`${SITE.name} falcon emblem`}
          width="800"
          height="628"
          fetchpriority="high"
          class="enter mx-auto w-full max-w-md"
          style="--enter-delay: 140ms;"
        />
        <p
          class="enter mt-8 text-center text-xl font-bold tracking-tight sm:text-2xl"
          style="--enter-delay: 320ms;"
        >
          {SITE.tagline}
        </p>
      </div>
    </div>
  </section>

  <!-- Capability strip -->
  <section aria-labelledby="capabilities" class="border-rule border-b">
    <div class="mx-auto max-w-7xl px-5 py-14 sm:px-8">
      <h2 id="capabilities" class="eyebrow">
        One partner, multiple capabilities
      </h2>
      <ul class="bg-rule mt-8 grid gap-px sm:grid-cols-2 lg:grid-cols-5">
        {
          SERVICES.map((service) => (
            <li class="bg-paper">
              <a
                href={`/services/#${service.slug}`}
                class="group hover:bg-surface block h-full p-5 transition-colors"
              >
                <span class="text-lg leading-snug font-bold">
                  {service.name}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Scale -->
  <section aria-labelledby="scale" class="on-navy bg-navy text-white">
    <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
      <h2 id="scale" class="eyebrow text-white/50">Delivery at scale</h2>
      <dl class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          stats.map((stat) => (
            <div class="border-t border-white/15 pt-5">
              <dt class="sr-only">{stat.label}</dt>
              <dd>
                <span class="block text-4xl font-bold tracking-tight sm:text-5xl">
                  {stat.href ? (
                    <a href={stat.href} class="link-underline">
                      {stat.value}
                    </a>
                  ) : (
                    stat.value
                  )}
                </span>
                <span class="mt-2 block text-sm text-white/65">
                  {stat.label}
                </span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Sector ledger preview -->
  <section aria-labelledby="sectors" class="border-rule border-b">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <div class="rule-mark flex flex-wrap items-end justify-between gap-4">
        <h2 id="sectors" class="text-h2 max-w-2xl font-bold">
          A portfolio of relevant projects highlighting our versatility and
          proven execution
        </h2>
        <a href="/clients/" class="link-underline eyebrow text-crimson"
          >All sectors</a
        >
      </div>

      <ul class="bg-rule mt-12 space-y-px">
        {
          SECTORS.slice(0, 3).map((row) => (
            <li class="bg-paper grid gap-4 py-7 md:grid-cols-[0.9fr_1.1fr_1fr] md:gap-10">
              <h3 class="text-xl font-bold">{row.sector}</h3>
              <p class="text-mute text-sm leading-relaxed">
                {row.clients.join(" · ")}
              </p>
              <p class="text-mute text-sm leading-relaxed">
                {row.delivered[0]}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Clients -->
  <section aria-labelledby="clients" class="border-rule bg-surface border-b">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <div class="rule-mark">
        <p class="eyebrow">Clients</p>
        <h2 id="clients" class="text-h2 mt-3 max-w-3xl font-bold">
          Supporting leading institutions and brands through our network of
          delivery partners
        </h2>
      </div>
      <img
        src="/img/clients.webp"
        alt="Client logos including Easypaisa, HIVE, Nishat Group, Hyundai, Zong, FrieslandCampina Engro, Barrick, Jazz, Ravi Urban Development Authority and Nestlé"
        width="1672"
        height="941"
        loading="lazy"
        class="border-rule mt-10 w-full border"
      />
    </div>
  </section>

  <!-- Projects preview -->
  <section aria-labelledby="work" class="border-rule border-b">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <div class="rule-mark flex flex-wrap items-end justify-between gap-4">
        <h2 id="work" class="text-h2 font-bold">Recent delivery</h2>
        <a href="/projects/" class="link-underline eyebrow text-crimson"
          >All projects</a
        >
      </div>
      <ul class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          featured.map((project) => (
            <li>
              <img
                src={project.image}
                alt=""
                width="1000"
                height="625"
                loading="lazy"
                class="aspect-[16/10] w-full object-cover"
              />
              <h3 class="mt-4 text-lg font-bold">{project.title}</h3>
              <p class="label text-crimson mt-1">{project.client}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="on-crimson bg-crimson text-white">
    <div
      class="mx-auto flex max-w-7xl flex-col gap-8 px-5 py-16 sm:px-8 lg:flex-row lg:items-center lg:justify-between"
    >
      <h2 class="text-h2 max-w-xl font-bold">
        Let's deliver your next project together.
      </h2>
      <div class="flex flex-wrap gap-4">
        <a
          href={`mailto:${SITE.email}`}
          class="text-crimson hover:bg-paper bg-white px-6 py-3.5 text-sm font-medium transition-colors"
          >{SITE.email}</a
        >
        <a
          href="/contact/"
          class="border border-white/70 px-6 py-3.5 text-sm font-medium transition-colors hover:bg-white/10"
          >Contact details</a
        >
        <a
          href="/leadership/"
          class="link-underline self-center text-sm font-medium"
          >Meet the team</a
        >
      </div>
    </div>
  </section>
</Base>
