---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { SERVICES } from "../data/content";
import { SITE } from "../site";
---

<Base
  title="Our services"
  description="Supply and general order, transportation and mobility, catering and events, creative design and print, and technology services — delivered nationwide."
>
  <PageHero
    eyebrow="Our services"
    title="One partner. Multiple capabilities."
    lede="Five service lines, delivered by our own teams and by specialist partner companies working under our management."
  />

  <!-- Index of service lines, so a long page stays navigable. -->
  <nav aria-label="Service lines" class="border-rule bg-surface border-b">
    <ul
      class="mx-auto flex max-w-7xl flex-wrap gap-x-6 gap-y-2 px-5 py-5 sm:px-8"
    >
      {
        SERVICES.map((service, index) => (
          <li>
            <a
              href={`#${service.slug}`}
              class="link-underline label text-mute hover:text-crimson"
            >
              <span class="text-crimson">
                {String(index + 1).padStart(2, "0")}
              </span>{" "}
              {service.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    {
      SERVICES.map((service, index) => (
        <section
          id={service.slug}
          aria-labelledby={`${service.slug}-heading`}
          class="border-rule grid gap-10 border-b py-16 sm:py-20 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16"
        >
          <div class="lg:sticky lg:top-28 lg:self-start">
            <p class="label text-crimson">
              {String(index + 1).padStart(2, "0")}
            </p>
            <h2 id={`${service.slug}-heading`} class="text-h2 mt-4 font-bold">
              {service.name}
            </h2>
            {service.partner && (
              <p class="border-crimson label text-crimson mt-4 inline-block border px-3 py-1.5">
                Delivered with {service.partner}
              </p>
            )}
            <p class="text-lede text-mute mt-5 leading-relaxed">
              {service.summary}
            </p>
          </div>

          <div>
            <h3 class="label text-mute">Core capabilities</h3>
            <ul class="bg-rule mt-5 space-y-px">
              {service.capabilities.map((capability) => (
                <li class="bg-paper py-4 text-sm leading-relaxed sm:text-base">
                  {capability}
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }
  </div>

  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
    <div class="rule-mark flex flex-wrap items-end justify-between gap-6">
      <h2 class="text-h2 max-w-xl font-bold">
        Need several of these under one contract?
      </h2>
      <a
        href={`mailto:${SITE.email}`}
        class="bg-crimson hover:bg-crimson-deep px-6 py-3.5 text-sm font-medium text-white transition-colors"
        >Email {SITE.email}</a
      >
    </div>
  </section>
</Base>
