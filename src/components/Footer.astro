---
import { NAV, SITE } from "../site";

const year = new Date().getFullYear();
---

<footer class="mt-24 bg-navy text-white/80">
  <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_1fr_1fr]">
      <div>
        <img
          src="/logo-mark.png"
          alt=""
          width="80"
          height="63"
          loading="lazy"
          class="h-12 w-auto"
        />
        <p class="mt-5 font-display text-2xl font-bold tracking-tight text-white">
          {SITE.tagline}
        </p>
        <p class="mt-3 max-w-sm text-sm leading-relaxed">
          {SITE.strapline} {SITE.subStrapline}
        </p>
      </div>

      <nav aria-label="Footer">
        <h2 class="font-mono text-label tracking-[0.2em] text-white/50 uppercase">
          Pages
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            NAV.map((item) => (
              <li>
                <a href={item.href} class="link-underline hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="font-mono text-label tracking-[0.2em] text-white/50 uppercase">
          Contact
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            SITE.phones.map((phone) => (
              <li>
                <a
                  href={`tel:${phone.number.replace(/\s/g, "")}`}
                  class="link-underline hover:text-white"
                >
                  {phone.number}
                </a>
                {phone.label && (
                  <span class="block text-xs text-white/45">{phone.label}</span>
                )}
              </li>
            ))
          }
          <li>
            <a
              href={`mailto:${SITE.email}`}
              class="link-underline hover:text-white">{SITE.email}</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-2 border-t border-white/10 pt-6 font-mono text-label tracking-[0.14em] text-white/45 uppercase sm:flex-row sm:items-center sm:justify-between"
    >
      <span>&copy; {year} {SITE.legalName}</span>
      <span>Established {SITE.established} &middot; Pakistan</span>
    </div>
  </div>
</footer>
