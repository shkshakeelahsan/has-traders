---
import { NAV, SITE } from "../site";

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-rule bg-paper/90 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-7xl items-center gap-6 px-5 py-3.5 sm:px-8">
    <a
      href="/"
      class="flex items-center gap-3"
      aria-label={`${SITE.name} — home`}
    >
      <img
        src="/logo-mark.png"
        alt=""
        width="44"
        height="35"
        class="h-8 w-auto sm:h-9"
        fetchpriority="high"
      />
      <span class="font-display text-lg leading-none font-bold tracking-tight">
        HAS <span class="text-crimson">Traders</span>
      </span>
    </a>

    <nav aria-label="Main" class="ml-auto hidden lg:block">
      <ul class="flex items-center gap-7">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
                class:list={[
                  "link-underline font-mono text-eyebrow tracking-[0.14em] uppercase transition-colors",
                  isCurrent(item.href)
                    ? "text-crimson"
                    : "text-mute hover:text-ink",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href="/contact/"
      class="ml-auto hidden bg-crimson px-4 py-2.5 font-mono text-eyebrow tracking-[0.14em] text-white uppercase transition-colors hover:bg-crimson-deep lg:ml-0 lg:block"
      >Start a project</a
    >

    <!-- No-JS disclosure menu for small screens. -->
    <details class="group relative ml-auto lg:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 border border-rule px-3 py-2 font-mono text-eyebrow tracking-[0.14em] uppercase [&::-webkit-details-marker]:hidden"
      >
        <span class="group-open:hidden">Menu</span>
        <span class="hidden group-open:inline">Close</span>
      </summary>
      <nav
        aria-label="Main"
        class="absolute right-0 mt-3 w-60 border border-rule bg-surface p-2 shadow-xl"
      >
        <ul>
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? "page" : undefined}
                  class:list={[
                    "block px-3 py-2.5 font-mono text-eyebrow tracking-[0.14em] uppercase",
                    isCurrent(item.href)
                      ? "bg-crimson-wash text-crimson"
                      : "text-mute hover:bg-paper hover:text-ink",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
